# Copy to .github/workflows/windows-installer.yml in MindTrail Lab's own repository.
name: Windows installer
on: workflow_dispatch
permissions:
  contents: read
jobs:
  package:
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.14'
      - run: python -m pip install -r requirements-build.txt
      - run: python -m unittest test_desktop test_bluetooth test_installer_build
      - run: choco install nsis --yes --no-progress
      - name: Build offline installer
        shell: pwsh
        run: |
          $env:PATH += ';C:\Program Files (x86)\NSIS'
          python installer_build.py windows
      - name: Exercise installer and private runtime
        shell: pwsh
        run: |
          $setup = (Get-ChildItem dist/*Windows*x64*Setup-unsigned.exe).FullName
          python installer/smoke_windows.py --installer $setup --report dist/windows-native-validation.json
      - uses: actions/upload-artifact@v4
        with:
          name: mindtrail-windows-unsigned
          path: |
            dist/*Windows*x64*Setup-unsigned.exe
            dist/*.sha256
            dist/windows-native-validation.json
